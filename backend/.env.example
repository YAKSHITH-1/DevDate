# ==============================================
# DevDate Backend Environment Configuration
# ==============================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (Required)
MONGO_URI=mongodb://127.0.0.1:27017/devdate

# JWT Secrets for Authentication (Required)
JWT_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here

# Token Expiry Settings (Optional - defaults to 15m and 7d)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Gmail OAuth2 Configuration for Nodemailer (Required)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS= # Optional when using OAuth2
GOOGLE_CLIENT_ID=your_google_oauth2_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth2_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth2_refresh_token
