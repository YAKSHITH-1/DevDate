# ==============================================
# DevDate Backend Environment Configuration
# ==============================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://your-production-domain.com
KEEP_ALIVE_URL=https://your-deployed-domain.com/health

# Database Configuration (Required)
MONGO_URI=mongodb://127.0.0.1:27017/devdate

# JWT Secrets for Authentication (Required)
JWT_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here

# Token Expiry Settings (Optional - defaults to 15m and 7d)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Brevo Transactional Email Configuration (Recommended for Production)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=DevDate

# Optional Gmail / SMTP Fallback Configuration
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ==============================================
# Rate Limiting Configuration (All Configurable)
# ==============================================
# 1. Strict Auth Routes (Per-IP & Per-Account with Exponential Backoff)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_IP=10
RATE_LIMIT_AUTH_MAX_ACCOUNT=5
RATE_LIMIT_AUTH_BASE_DELAY_MS=2000
RATE_LIMIT_AUTH_MAX_DELAY_MS=300000
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2

# 2. Moderate Public Endpoints (IP-based)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100

# 3. Looser Authenticated User Actions (User-based)
RATE_LIMIT_USER_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=1000
